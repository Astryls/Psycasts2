<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- The altar building. Not buildable by the player; spawned by the quest at the site map's center. -->
  <ThingDef ParentName="BuildingBase">
    <defName>PS_PilgrimAltar</defName>
    <label>pilgrim's altar</label>
    <description>A monolith of psychic resonance. An Awakened may meditate here to break through to the next tier of Enlightenment.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/PS_PilgrimAltar</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(2, 2)</size>
    <statBases>
      <MaxHitPoints>2000</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>40</Beauty>
      <MeditationFocusStrength>0.36</MeditationFocusStrength>
    </statBases>
    <comps>
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes>
          <li>PS_UniversalFocus</li>
        </focusTypes>
      </li>
      <li Class="PsycastSynergies.CompProperties_PilgrimMeditation" />
    </comps>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>50</pathCost>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <!-- Meditation thrones (custom). Look like vanilla Throne / GrandThrone (same textures) but use
       requirement-free PS_UniversalFocus focus type instead of Dignified - so any awakened pilgrim can
       meditate here, no royal title required. Spawned wrapped in a stone reliquary by the altar-chain quests. -->
  <ThingDef ParentName="BuildingBase">
    <defName>PS_PilgrimThrone</defName>
    <label>pilgrim's meditation throne</label>
    <description>An ornate throne enshrined at a place of psychic resonance. An Awakened may meditate here to break through to the next tier of Enlightenment.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Furniture/Throne</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2.4,2.4)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <defaultPlacingRot>South</defaultPlacingRot>
    <hasInteractionCell>true</hasInteractionCell>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>40</Beauty>
      <MeditationFocusStrength>0.36</MeditationFocusStrength>
    </statBases>
    <comps>
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes><li>PS_UniversalFocus</li></focusTypes>
      </li>
      <li Class="PsycastSynergies.CompProperties_PilgrimMeditation" />
    </comps>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>30</pathCost>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <isSittable>true</isSittable>
    </building>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>PS_PilgrimGrandThrone</defName>
    <label>pilgrim's grand meditation throne</label>
    <description>A primordial grand throne enshrined at a place of deepest psychic resonance. An Awakened of the second tier may meditate here to break through to the third.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Furniture/GrandThrone</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <size>(3,2)</size>
    <interactionCellOffset>(0,0,1)</interactionCellOffset>
    <defaultPlacingRot>South</defaultPlacingRot>
    <hasInteractionCell>true</hasInteractionCell>
    <statBases>
      <MaxHitPoints>3000</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>60</Beauty>
      <MeditationFocusStrength>0.48</MeditationFocusStrength>
    </statBases>
    <comps>
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes><li>PS_UniversalFocus</li></focusTypes>
      </li>
      <li Class="PsycastSynergies.CompProperties_PilgrimMeditation" />
    </comps>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>30</pathCost>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <isSittable>true</isSittable>
    </building>
  </ThingDef>

  <!-- The world-map site that hosts the altar. Default worker; map generates with vanilla terrain.
       siteTexture / expandingIconTexture are REQUIRED - without them WorldDrawLayer_WorldObjects_Expandable
       throws ArgumentNullException every frame and breaks the world map render. -->
  <SitePartDef>
    <defName>PS_PilgrimSite</defName>
    <label>pilgrim's altar</label>
    <description>A place of psychic resonance, where an Awakened may meditate to break through to the next tier of Enlightenment.</description>
    <workerClass>PsycastSynergies.SitePartWorker_PilgrimAltar</workerClass>
    <wantsThreatPoints>false</wantsThreatPoints>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/Expanding/PilgrimSite</expandingIconTexture>
    <approachOrderString>Travel to {0}</approachOrderString>
    <approachingReportString>Approaching {0}.</approachingReportString>
    <arrivedLetterDef>NeutralEvent</arrivedLetterDef>
  </SitePartDef>

  <!-- ────────────────────────────────────────────────────────────────────────
       Ancient anima tree - the T3 anima site's focus. Inherits the vanilla
       anima tree (`TreeAnima`), so it keeps its glow / subplant / meditation
       focus comps. Bigger (visualSizeRange) + stronger (MeditationFocusStrength).
       ──────────────────────────────────────────────────────────────────────── -->
  <ThingDef ParentName="TreeAnima">
    <defName>PS_GiantAnimaTree</defName>
    <label>ancient anima tree</label>
    <description>A primordial anima tree, far greater than any modern specimen. Its psychic presence amplifies meditation many times over. Found only at sites of deepest psychic resonance.</description>
    <statBases>
      <Beauty>50</Beauty>
      <BeautyOutdoors>50</BeautyOutdoors>
      <MeditationFocusStrength>0.55</MeditationFocusStrength>
      <MaxHitPoints>3000</MaxHitPoints>
      <Flammability>0</Flammability>
      <MeditationPlantGrowthOffset>0</MeditationPlantGrowthOffset>
    </statBases>
    <plant>
      <growDays>30</growDays>
      <visualSizeRange>4.5~5.5</visualSizeRange>
    </plant>
    <comps>
      <li Class="PsycastSynergies.CompProperties_PilgrimMeditation" />
    </comps>
  </ThingDef>

  <!-- ────────────────────────────────────────────────────────────────────────
       PILGRIMAGE QUESTS - all share QuestNode_PilgrimRoot; differ only in
       targetTier + focusOverride + wave scale. Two chains: ALTAR (default) and
       ANIMA (the world-tree chain).
       ──────────────────────────────────────────────────────────────────────── -->

  <!-- Chain 1: ALTAR (T2 = existing). T3 = altar at higher cost (future). -->
  <QuestScriptDef>
    <defName>PS_TierIIPilgrimage</defName>
    <questNameRules>
      <rulesStrings>
        <li>questName->A Pilgrim's Path</li>
        <li>questName->The Second Awakening</li>
        <li>questName->Toward Higher Enlightenment</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->A site of psychic resonance has manifested on the world map. An Awakened colonist who travels there and meditates at the altar will break through to the second tier of Enlightenment, choosing a new psycast school in the process.\n\nThe Ancient Psycaster Order will send waves of adepts to test them. The site fades after a month.</li>
      </rulesStrings>
    </questDescriptionRules>
    <expireDaysRange>4~7</expireDaysRange>
    <rootSelectionWeight>0.4</rootSelectionWeight>
    <rootMinPoints>0</rootMinPoints>
    <minRefireDays>30</minRefireDays>
    <root Class="PsycastSynergies.QuestNode_PilgrimRoot">
      <wrapInReliquary>true</wrapInReliquary>
    </root>
  </QuestScriptDef>

  <!-- Chain 1 (continued): ALTAR T3 - same combat shape, harder waves. -->
  <QuestScriptDef>
    <defName>PS_TierIIIPilgrimage</defName>
    <questNameRules>
      <rulesStrings>
        <li>questName->Trial of Illumination</li>
        <li>questName->Path of the Illuminated</li>
        <li>questName->The Third Awakening</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->A site of deeper psychic resonance has manifested. A colonist of the second tier of Enlightenment who travels there and survives the assault of the Ancient Psycaster Order while meditating at the altar will break through to the third tier - Illuminated.\n\nThe Order will field considerably harder waves at this site. The site fades after a month.</li>
      </rulesStrings>
    </questDescriptionRules>
    <expireDaysRange>4~7</expireDaysRange>
    <rootSelectionWeight>0.25</rootSelectionWeight>
    <rootMinPoints>0</rootMinPoints>
    <minRefireDays>60</minRefireDays>
    <root Class="PsycastSynergies.QuestNode_PilgrimRoot">
      <targetTier>3</targetTier>
      <focusOverride>PS_PilgrimGrandThrone</focusOverride>
      <wavePointsScale>1.6</wavePointsScale>
      <wrapInReliquary>true</wrapInReliquary>
    </root>
  </QuestScriptDef>

  <!-- Chain 2: ANIMA T2 - PACIFIST. Multi-site journey, no waves. Travel to several anima trees. -->
  <QuestScriptDef>
    <defName>PS_T2AnimaPilgrimage</defName>
    <questNameRules>
      <rulesStrings>
        <li>questName->Song of the Anima</li>
        <li>questName->Beneath the World-Trees</li>
        <li>questName->A Pilgrimage Among the Groves</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->Several anima trees across the world have stirred in unison, calling to the Awakened. A colonist of the first tier of Enlightenment must travel to each and meditate beneath its boughs to break through to the second tier.\n\nThis is a pacifist pilgrimage: no enemies will attack the sites. The total commitment is far longer than the altar trial. The sites fade after two months.</li>
      </rulesStrings>
    </questDescriptionRules>
    <expireDaysRange>5~10</expireDaysRange>
    <rootSelectionWeight>0.3</rootSelectionWeight>
    <rootMinPoints>0</rootMinPoints>
    <minRefireDays>40</minRefireDays>
    <root Class="PsycastSynergies.QuestNode_AnimaPilgrimRoot">
      <targetTier>2</targetTier>
      <siteCount>3</siteCount>
      <focusOverride>Plant_TreeAnima</focusOverride>
    </root>
  </QuestScriptDef>

  <!-- Chain 2: ANIMA T3 - PACIFIST. Longer journey, the LAST site spawns the GIANT anima tree. -->
  <QuestScriptDef>
    <defName>PS_T3AnimaPilgrimage</defName>
    <questNameRules>
      <rulesStrings>
        <li>questName->The Ancient World-Tree</li>
        <li>questName->Pilgrimage to the Primordial</li>
        <li>questName->Beneath the World-Spirits</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->Several anima trees have manifested across the world, with one site graced by an ancient anima tree - a primordial world-spirit of extraordinary power. A colonist of the second tier of Enlightenment must travel to each and meditate to break through to the third tier - Illuminated.\n\nThis is a pacifist pilgrimage: no enemies will attack the sites. The total commitment is the longest in the order. The sites fade after two months.</li>
      </rulesStrings>
    </questDescriptionRules>
    <expireDaysRange>5~10</expireDaysRange>
    <rootSelectionWeight>0.2</rootSelectionWeight>
    <rootMinPoints>0</rootMinPoints>
    <minRefireDays>70</minRefireDays>
    <root Class="PsycastSynergies.QuestNode_AnimaPilgrimRoot">
      <targetTier>3</targetTier>
      <siteCount>4</siteCount>
      <focusOverride>Plant_TreeAnima</focusOverride>
      <lastSiteFocusOverride>PS_GiantAnimaTree</lastSiteFocusOverride>
    </root>
  </QuestScriptDef>
</Defs>
