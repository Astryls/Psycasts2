<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Ascension aura particles (emitted from HediffComp_AscensionFx, tinted per path at spawn). -->

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>PS_Fleck_Leaf</defName>
    <graphicData>
      <texPath>FX/Ascension/leaf</texPath>
      <graphicClass>Graphic_Fleck</graphicClass>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.15</fadeInTime>
    <solidTime>0.25</solidTime>
    <fadeOutTime>1.1</fadeOutTime>
    <growthRate>-0.12</growthRate>
  </FleckDef>

